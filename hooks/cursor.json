{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-briefing.mjs\"",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/subagent-gate.mjs\"",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/subagent-gate.mjs\"",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/verification-gate.mjs\"",
        "timeout": 5
      }
    ]
  }
}
