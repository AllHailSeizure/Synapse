{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-briefing.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading Synapse briefing"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/succinct-reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
